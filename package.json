{
  "name": "cv-tailor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate || echo \"prisma generate could not replace the engine file (is another dev server running?) - continuing\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts && playwright install chromium",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@anthropic-ai/sdk": "^0.128.0",
    "@base-ui/react": "^1.8.0",
