# Copy to .env.local and fill in. Never commit .env.local.
# Pick the provider in Settings -> AI.

# "Anthropic API": pay-per-token key from console.anthropic.com
ANTHROPIC_API_KEY=

# "Claude plan": uses your Claude Pro / Max / Team subscription through the Claude Agent SDK.
# Either log in once (run `claude`, then /login), or run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
